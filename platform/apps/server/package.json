{
  "name": "@docket/server-platform",
  "version": "0.0.0",
  "private": true,
  "description": "The Docket Cloud web app and JSON API (SvelteKit, adapter-node).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build && vite build --config vite.mcp-app.config.ts",
    "start": "node build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "svelte-kit sync && vitest run --exclude 'src/**/*.int.test.ts'",
    "test:integration": "svelte-kit sync && vitest run --testTimeout 30000 --hookTimeout 30000 .int.test."
  },
  "dependencies": {
    "@chrisjowen/docket": "workspace:*",
    "@docket/platform-ai": "workspace:*",
    "@docket/platform-audit": "workspace:*",
    "@docket/platform-auth": "workspace:*",
    "@docket/platform-canonical-store": "workspace:*",
    "@docket/platform-enrichment": "workspace:*",
    "@docket/platform-github": "workspace:*",
    "@docket/platform-keys": "workspace:*",
    "@docket/platform-limits": "workspace:*",
    "@docket/platform-mcp-tools": "workspace:*",
    "@docket/platform-ontology-service": "workspace:*",
    "@docket/platform-provisioner": "workspace:*",
    "@docket/platform-tenancy": "workspace:*",
    "@docket/server-worker": "workspace:*",
    "@openuidev/svelte-lang": "0.4.2",
    "@prometheus-io/client": "^0.16.1",
    "oidc-provider": "9.13.3",
    "pg": "^8.16.3",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@lucide/svelte": "^0.554.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/pg": "^8.15.6",
    "d3-drag": "^3.0.1",
    "d3-force": "^3.0.1",
    "d3-selection": "^3.0.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "exports": {
    "./runtime": "./runtime.js",
    "./package.json": "./package.json"
  }
}
