{
  "name": "@docket/platform-tenancy",
  "version": "0.0.0",
  "private": true,
  "description": "Organisation, workspace and membership model: ids, roles and the per-org names every store uses.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./roles": "./src/roles.ts",
    "./testing": "./src/testing.ts",
    "./names": "./src/names.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude 'src/**/*.int.test.ts' --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --testTimeout 30000 --hookTimeout 30000 .int.test."
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
