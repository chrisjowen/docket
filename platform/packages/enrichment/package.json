{
  "name": "@docket/platform-enrichment",
  "version": "0.0.0",
  "private": true,
  "description": "Background enrichment: a per-workspace job that infers the links, owners, duplicates and contradictions a workspace's documents imply, and writes each as an inferred document with its reasoning and evidence.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude 'src/**/*.int.test.ts' --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --testTimeout 30000 --hookTimeout 30000 .int.test."
  },
  "dependencies": {
    "@chrisjowen/docket": "workspace:*",
    "@docket/platform-ai": "workspace:*",
    "@docket/platform-audit": "workspace:*",
    "@docket/platform-canonical-store": "workspace:*",
    "@docket/platform-ontology-service": "workspace:*",
    "@docket/platform-tenancy": "workspace:*",
    "pg": "^8.16.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@docket/platform-provisioner": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
