node_modules/
dist/
*.tsbuildinfo
.DS_Store
# Derived, never canonical. Anchored patterns would miss examples/*/.docket/.
**/.docket/.index/
**/.docket/.cache/
# The web UI's SvelteKit output; the docket build copies it into dist/ui.
.svelte-kit/
packages/docket-ui/build/
.docket/.index/
.docket/.cache/
packages/docket-ui/embed/
packages/docket-ui/mcp-app/
# Except the docket that docket's Wheelhouse plugin ships and runs, which
# wheelhouse/build.mjs builds and checks.
!/wheelhouse/docket/**
# Self-hosting secrets: Compose's .env and mounted key files, never committed.
deploy/compose/.env
/deploy/compose/docket-server.yaml
deploy/compose/secrets/
/deploy/compose/worker-tls/
# The server platform's build output (with the web UI copied in) and Playwright reports.
platform/apps/server/build/
platform/apps/server/ui/
# The multi-tenant server's web UI: its build and packed artifacts.
packages/docket-ui/cloud/build/
packages/docket-ui/cloud/dist/
platform/playwright-report/
platform/test-results/
