# Copy to .env beside the Compose files and fill in before launching.
COMPOSE_PROFILES=postgres,graph,semantic
# DOCKET_IMAGE=docket:local
# DOCKET_SERVER_CONFIG=./docket-server.yaml
# DOCKET_SECRETS_DIR=./secrets
# DOCKET_PUBLIC_URL=http://127.0.0.1:4390

# Generate each of these independent passwords with openssl rand -hex 24.
POSTGRES_PASSWORD=
DOCKET_PG_APP_PASSWORD=
NEO4J_PASSWORD=
QDRANT_API_KEY=

# Your GitHub OAuth App secret, referenced by docket-server.yaml.
DOCKET_GITHUB_CLIENT_SECRET=
