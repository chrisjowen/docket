# Copy to .env beside compose.yaml and fill in. .env holds secrets: it is in
# .gitignore, and never belongs in a commit. See docs/deploy.md.

# The image. Pin a version; build your own with
#   docker build -f deploy/image/Dockerfile -t ghcr.io/chrisjowen/docket:dev .
# DOCKET_IMAGE=ghcr.io/chrisjowen/docket:0.14.0

# The workspace's name: its MCP endpoint is /mcp/<name> (and /mcp).
# DOCKET_WORKSPACE=docket

# Where docket listens on the host. 127.0.0.1 keeps it on this machine; put a
# TLS-terminating reverse proxy in front before tokens cross a network, and set
# the URL clients reach it at.
# DOCKET_BIND=127.0.0.1
# DOCKET_PORT=4390
# DOCKET_PUBLIC_URL=https://docket.example.com

# The roles whose tokens may publish the ontology over MCP.
# DOCKET_ONTOLOGY_MCP_WRITERS=owner

# Opt-in stores: the profiles to run, comma-separated.
# COMPOSE_PROFILES=postgres,graph,semantic,cognee

# --- postgres: Postgres is the canonical store ------------------------------
# POSTGRES_PASSWORD=<openssl rand -hex 24>
# DOCKET_DATABASE_URL=postgres://docket:${POSTGRES_PASSWORD}@postgres:5432/docket
# Projections fed from it: jsonl (the default), sqlite, postgres.
# DOCKET_PROJECTIONS=postgres
# Seal document bodies at rest with a key kept outside the database:
#   mkdir -p secrets && openssl rand -hex 32 > secrets/codec.key
# DOCKET_CODEC_KEY_FILE=/run/secrets/docket/codec.key

# --- graph: Neo4j -----------------------------------------------------------
# NEO4J_PASSWORD=<openssl rand -hex 24>

# --- semantic: Qdrant and an Ollama embedder --------------------------------
# EMBEDDER_MODELS=nomic-embed-text

# --- cognee -----------------------------------------------------------------
# COGNEE_DEFAULT_PASSWORD=<openssl rand -hex 24>
# COGNEE_API_KEY=<made on cognee once it runs: docs/deploy.md>
# Its model: by default Ollama's qwen2.5:7b on the embedder (add it to EMBEDDER_MODELS).
# EMBEDDER_MODELS=nomic-embed-text qwen2.5:7b
# COGNEE_LLM_PROVIDER=ollama
# COGNEE_LLM_MODEL=qwen2.5:7b
# COGNEE_LLM_ENDPOINT=http://embedder:11434
# COGNEE_LLM_API_KEY=ollama
