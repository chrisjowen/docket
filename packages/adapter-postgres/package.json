{
  "name": "@docket/adapter-postgres",
  "version": "0.0.0",
  "private": true,
  "description": "docket's Postgres adapter: entities and their links in Postgres tables, searched by full-text and title trigrams, optionally by pgvector embeddings, and answered with the paths from each match.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@docket/adapter-kit": "workspace:*",
    "@docket/contracts": "workspace:*",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
