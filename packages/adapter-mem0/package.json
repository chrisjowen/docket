{
  "name": "@docket/adapter-mem0",
  "version": "0.0.0",
  "private": true,
  "description": "docket's mem0 adapter: one verbatim memory per entity on hosted mem0, its self-hosted server or mem0ai/oss.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepare": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@docket/adapter-kit": "workspace:*",
    "@docket/contracts": "workspace:*",
    "mem0ai": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@qdrant/js-client-rest": "^1.18.0",
    "@types/node": "^22.10.2",
    "ollama": "^0.5.18",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
