{
  "name": "@team-memory/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "memory": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/ontology && cp src/ontology/*.yaml dist/ontology/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.1",
    "gray-matter": "^4.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "mem0ai": "^3.3.1"
  },
  "peerDependenciesMeta": {
    "mem0ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "mem0ai": "^3.3.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
