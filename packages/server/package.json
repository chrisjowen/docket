{
  "name": "@chrisjowen/docket-server",
  "version": "0.2.0",
  "description": "The core a Docket server is built on: the ports a deployment plugs its storage, auth and tenancy into, the scope and role vocabulary MCP calls are checked against, the ontology lifecycle and how writes become documents.",
  "license": "Apache-2.0",
  "keywords": [
    "docket",
    "mcp",
    "ontology",
    "knowledge"
  ],
  "homepage": "https://github.com/chrisjowen/docket/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/chrisjowen/docket/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisjowen/docket.git",
    "directory": "packages/server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "templates": "node scripts/templates.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@chrisjowen/docket": "^0.10.0"
  },
  "devDependencies": {
    "@chrisjowen/docket": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
