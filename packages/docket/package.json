{
  "name": "@chrisjowen/docket",
  "version": "0.7.0",
  "description": "Capture and classify project knowledge as typed Markdown in your repository; indexes are disposable projections.",
  "keywords": [
    "knowledge",
    "ontology",
    "markdown",
    "claude-code",
    "mem0",
    "neo4j"
  ],
  "homepage": "https://github.com/chrisjowen/docket#readme",
  "bugs": {
    "url": "https://github.com/chrisjowen/docket/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisjowen/docket.git",
    "directory": "packages/docket"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/neo4j": {
      "types": "./dist/bundled/adapter-neo4j/dist/index.d.ts",
      "import": "./dist/bundled/adapter-neo4j/dist/index.js"
    },
    "./adapters/mem0": {
      "types": "./dist/bundled/adapter-mem0/dist/index.d.ts",
      "import": "./dist/bundled/adapter-mem0/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "docket": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/bundle-packages.mjs && mkdir -p dist/ontology && cp src/ontology/*.yaml dist/ontology/ && node scripts/copy-ui.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:ask": "vitest run --config eval/vitest.config.ts"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.1",
    "gray-matter": "^4.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "mem0ai": "^3.3.1",
    "neo4j-driver": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "mem0ai": {
      "optional": true
    },
    "neo4j-driver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@docket/adapter-cloud": "workspace:*",
    "@docket/adapter-jsonl": "workspace:*",
    "@docket/adapter-kit": "workspace:*",
    "@docket/adapter-mem0": "workspace:*",
    "@docket/adapter-neo4j": "workspace:*",
    "@docket/contracts": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
