{
  "name": "@chrisjowen/docket",
  "version": "0.13.0",
  "description": "Capture and classify project knowledge as typed Markdown in your repository; indexes are disposable projections.",
  "license": "Apache-2.0",
  "keywords": [
    "knowledge",
    "ontology",
    "markdown",
    "claude-code",
    "mem0",
    "neo4j",
    "cognee",
    "postgres",
    "sqlite"
  ],
  "homepage": "https://github.com/chrisjowen/docket#readme",
  "bugs": {
    "url": "https://github.com/chrisjowen/docket/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisjowen/docket.git",
    "directory": "packages/docket"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/neo4j": {
      "types": "./dist/bundled/adapter-neo4j/dist/index.d.ts",
      "import": "./dist/bundled/adapter-neo4j/dist/index.js"
    },
    "./adapters/mem0": {
      "types": "./dist/bundled/adapter-mem0/dist/index.d.ts",
      "import": "./dist/bundled/adapter-mem0/dist/index.js"
    },
    "./adapters/cognee": {
      "types": "./dist/bundled/adapter-cognee/dist/index.d.ts",
      "import": "./dist/bundled/adapter-cognee/dist/index.js"
    },
    "./adapters/postgres": {
      "types": "./dist/bundled/adapter-postgres/dist/index.d.ts",
      "import": "./dist/bundled/adapter-postgres/dist/index.js"
    },
    "./adapters/sqlite": {
      "types": "./dist/bundled/adapter-sqlite/dist/index.d.ts",
      "import": "./dist/bundled/adapter-sqlite/dist/index.js"
    },
    "./contracts": {
      "types": "./dist/bundled/contracts/dist/index.d.ts",
      "import": "./dist/bundled/contracts/dist/index.js"
    },
    "./adapter-kit": {
      "types": "./dist/bundled/adapter-kit/dist/index.d.ts",
      "import": "./dist/bundled/adapter-kit/dist/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./manifest/adapter-manifest": {
      "types": "./dist/manifest/adapter-manifest.d.ts",
      "import": "./dist/manifest/adapter-manifest.js"
    },
    "./manifest/plan": {
      "types": "./dist/manifest/plan.d.ts",
      "import": "./dist/manifest/plan.js"
    },
    "./mcp/search": {
      "types": "./dist/mcp/search.d.ts",
      "import": "./dist/mcp/search.js"
    },
    "./mcp/surface": {
      "types": "./dist/mcp/surface/index.d.ts",
      "import": "./dist/mcp/surface/index.js"
    },
    "./mcp/types": {
      "types": "./dist/mcp/types.d.ts",
      "import": "./dist/mcp/types.js"
    },
    "./ontology/icons": {
      "types": "./dist/ontology/icons.d.ts",
      "import": "./dist/ontology/icons.js"
    },
    "./open/graph": {
      "types": "./dist/open/graph.d.ts",
      "import": "./dist/open/graph.js"
    },
    "./open/types": {
      "types": "./dist/open/types.d.ts",
      "import": "./dist/open/types.js"
    },
    "./query/ask": {
      "types": "./dist/query/ask.d.ts",
      "import": "./dist/query/ask.js"
    },
    "./query/legacy": {
      "types": "./dist/query/legacy.d.ts",
      "import": "./dist/query/legacy.js"
    },
    "./query/snapshot": {
      "types": "./dist/query/snapshot.d.ts",
      "import": "./dist/query/snapshot.js"
    },
    "./query/synthesis": {
      "types": "./dist/query/synthesis.d.ts",
      "import": "./dist/query/synthesis.js"
    },
    "./source/hashing": {
      "types": "./dist/source/hashing.d.ts",
      "import": "./dist/source/hashing.js"
    },
    "./source/parser": {
      "types": "./dist/source/parser.d.ts",
      "import": "./dist/source/parser.js"
    },
    "./sync/inputs": {
      "types": "./dist/sync/inputs.d.ts",
      "import": "./dist/sync/inputs.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "docket": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/bundle-packages.mjs && mkdir -p dist/ontology && cp src/ontology/*.yaml dist/ontology/ && node scripts/copy-ui.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:ask": "vitest run --config eval/vitest.config.ts eval/ask",
    "eval:search": "vitest run --config eval/vitest.config.ts eval/search",
    "eval:search:download": "node eval/search/download.mjs"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.1",
    "gray-matter": "^4.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.6.2",
    "mem0ai": "^3.3.1",
    "neo4j-driver": "^6.0.0",
    "pg": "^8.16.3"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "mem0ai": {
      "optional": true
    },
    "neo4j-driver": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@docket/adapter-cloud": "workspace:*",
    "@docket/adapter-cognee": "workspace:*",
    "@docket/adapter-jsonl": "workspace:*",
    "@docket/adapter-kit": "workspace:*",
    "@docket/adapter-mem0": "workspace:*",
    "@docket/adapter-neo4j": "workspace:*",
    "@docket/adapter-postgres": "workspace:*",
    "@docket/adapter-sqlite": "workspace:*",
    "@docket/contracts": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
